<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
	<session-factory>
		<property name="hibernate.connection.datasource">java:comp/env/jdbc/polybrain</property>
		<property name="hibernate.current_session_context_class">thread</property>
		
		
<!-- 		<property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>-->
<!--         <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/polybrain_mem?serverTimezone=Asia/Taipei</property>-->
<!--         <property name="hibernate.connection.username">root</property>-->
<!--         <property name="hibernate.connection.password">06494784</property>-->
		
		<property name="hibernate.dialect">org.hibernate.dialect.MySQLDialect</property>
		<property name="hibernate.show_sql">true</property>
		<property name="hibernate.format_sql">true</property>

		<mapping class="com.polybrain.employee.entity.EmpVo" />
		<mapping class="com.polybrain.member.entity.MemVo" />
		<mapping class="com.polybrain.bid.entity.BidItemVo" />
		<mapping class="com.polybrain.bid.entity.BidItemPicVo" />
		<mapping class="com.polybrain.bid.entity.BidOrderDetailVo" />
		<mapping class="com.polybrain.bid.entity.BidEventVo" />
		<mapping class="com.polybrain.bid.entity.BidOrderVo" />
		<mapping class="com.polybrain.item.entity.Item" />
		<mapping class="com.polybrain.item.entity.ItemClass" />
		<mapping class="com.polybrain.item.entity.ItemImg" />
		<mapping class="com.polybrain.order.entity.ItemOrderVO" />
		<mapping class="com.polybrain.order.entity.ItemOrderDetailVO" />
		<mapping class="com.polybrain.cart.entity.CartTraceVO" />


	</session-factory>
</hibernate-configuration>
